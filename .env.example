# Copy this file to .env (local) or paste these into Render > Environment (cloud).
# Never commit the real .env file.

# Researcher dashboard password (choose a long one) and a random secret for signing the login cookie
ADMIN_PASSWORD=change-me
SECRET_KEY=paste-a-long-random-string-here

# Leave empty to use the local file hti_study.db; for the cloud use the Neon connection string
DATABASE_URL=

# AI help: Gemini first, Groq as fallback; if both fail, written fallback answers are used
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
